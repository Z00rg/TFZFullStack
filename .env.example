# ---------------------------------------------------------------------------
# Postgres (Vercel Storage → Neon)
# ---------------------------------------------------------------------------
# Интеграция Vercel проставляет DATABASE_URL автоматически.
#
# Для приложения подойдёт любая строка. Для миграций (`npm run db:migrate`)
# лучше брать прямое подключение без пулера — интеграция Vercel кладёт его в
# DATABASE_URL_UNPOOLED. Пулер Neon работает в transaction mode, и длинные
# DDL-транзакции через него проходят не всегда.
DATABASE_URL="postgresql://user:password@host-pooler.region.aws.neon.tech/dbname?sslmode=require"

# ---------------------------------------------------------------------------
# Подпись JWT — минимум 32 символа
# ---------------------------------------------------------------------------
# Сгенерировать: openssl rand -base64 48
JWT_SECRET="замените-на-случайную-строку-минимум-32-символа"

# Время жизни токенов (s / m / h / d). Необязательные.
ACCESS_TOKEN_TTL="15m"
REFRESH_TOKEN_TTL="7d"

# ---------------------------------------------------------------------------
# Redis (Vercel Storage → Upstash)
# ---------------------------------------------------------------------------
# Интеграция Vercel проставляет KV_REST_API_URL / KV_REST_API_TOKEN —
# приложение понимает оба набора имён.
# Без них локально включается in-memory заглушка; в продакшене — ошибка.
UPSTASH_REDIS_REST_URL=""
UPSTASH_REDIS_REST_TOKEN=""

# ---------------------------------------------------------------------------
# Ограничение частоты входа. Необязательные.
# ---------------------------------------------------------------------------
LOGIN_RATE_LIMIT="5"
LOGIN_RATE_WINDOW_SECONDS="60"

# ---------------------------------------------------------------------------
# Данные первого главного администратора для `npm run db:seed`
# ---------------------------------------------------------------------------
SEED_SUPERADMIN_EMAIL="admin@example.com"
SEED_SUPERADMIN_PASSWORD=""
SEED_SUPERADMIN_NAME="Имя"
SEED_SUPERADMIN_SURNAME="Фамилия"
